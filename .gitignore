# Sanal ortam
.venv/

# Gizli anahtarlar
backend/.env
backend/app/_secrets.py

# Python
__pycache__/
*.pyc

# Çalışma zamanı verisi (yüklenen/oluşturulan dosyalar)
data/uploads/*
data/output/*
!data/uploads/.gitkeep
!data/output/.gitkeep

# Orijinal müşteri örnek sunumları (büyük, özel dosyalar — repoya dahil edilmiyor)
*.pptm

# Editör/OS
.vs/
.vscode/
Thumbs.db

# PyInstaller build ciktilari (buyuk, ikili dosyalar — repoya dahil edilmiyor,
# .exe dogrudan ekip arkadaslarina paylasilir)
build/
dist/
