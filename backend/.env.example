# AI ile açıklama üretimi için OpenAI API anahtarınızı buraya girin.
# Bu dosyayı backend/.env olarak kopyalayıp değeri doldurun.
OPENAI_API_KEY=sk-...

# İsteğe bağlı: caption üretiminde kullanılacak model (varsayılan: gpt-4o-mini).
# Farklı bir model için OpenAI dashboard'unda (Models sekmesi) API'de kullanılan
# tam ID'yi kontrol edip buraya yazın (örn. gpt-4o).
# OPENAI_CAPTION_MODEL=gpt-4o

# İsteğe bağlı: ikisi de doluysa siteye girerken ortak kullanıcı adı/şifre
# sorulur (paylaşılan bir sunucuda barındırırken önerilir). Boş bırakılırsa
# (yerel kullanımda olduğu gibi) şifre sorulmaz.
# APP_USERNAME=limonarisi
# APP_PASSWORD=degistir-bunu

# İsteğe bağlı: videolar sıkıştırıldıktan SONRA, bir sunumdaki videoların
# toplam boyutu için MB cinsinden üst sınır (varsayılan: 150). Render'ın
# ücretsiz katmanı 512MB RAM ile sınırlı ve python-pptx her videoyu tamamen
# belleğe okuyor; bu sınır aşılırsa sunucu sessizce çökmek yerine kullanıcıya
# net bir hata verir. Daha fazla RAM'li bir plana geçerseniz bu değeri
# yükseltebilirsiniz.
# MAX_VIDEO_TOTAL_MB=150

# İsteğe bağlı: yüklenebilecek TEK bir ham (sıkıştırma öncesi) video dosyası
# için MB cinsinden üst sınır (varsayılan: 500). Yanlışlıkla devasa bir
# dosya yüklenip ffmpeg'i uzun süre meşgul etmesini önler.
# MAX_RAW_VIDEO_MB_PER_FILE=500
