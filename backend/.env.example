# Bu proje artik iki ayri uygulamadan olusuyor, ayni backend/.env dosyasini
# paylasiyorlar (dev ortaminda). Bu dosyayi backend/.env olarak kopyalayip
# calistiracaginiz uygulamaya gore ilgili degerleri doldurun.

# =============================================================
# cloud_app.py icin (Render'da barinan, sadece caption ureten servis)
# =============================================================

# AI ile açıklama üretimi için OpenAI API anahtarınızı buraya girin.
OPENAI_API_KEY=sk-...

# İsteğe bağlı: caption üretiminde kullanılacak model (varsayılan: gpt-4o-mini).
# Farklı bir model için OpenAI dashboard'unda (Models sekmesi) API'de kullanılan
# tam ID'yi kontrol edip buraya yazın (örn. gpt-4o).
# OPENAI_CAPTION_MODEL=gpt-4o

# İsteğe bağlı: doluysa /api/caption-from-frames ve /api/revise-caption
# istekleri, masaüstü uygulamasının gönderdiği X-App-Key header'ının bu
# değerle eşleşmesini ister (paylaşılan/canlı sunucuda önerilir — yoksa
# URL'yi bulan herkes OpenAI faturanızı ücretsiz kullanabilir). Masaüstü
# .exe'sini derlerken aynı değeri APP_KEY olarak gömmeniz gerekir.
# APP_KEY=degistir-bunu-uzun-rastgele-bir-deger

# =============================================================
# main.py / desktop_launcher.py icin (masaüstü uygulaması, yerelde çalışır)
# =============================================================

# İsteğe bağlı: caption isteklerinin gönderileceği bulut servisinin adresi.
# Varsayılan olarak Render'daki canlı servis kullanılır; sadece kendi
# makinende cloud_app.py'yi de ayrı çalıştırıp ona bağlanmak istersen
# değiştir (örn. http://127.0.0.1:8010).
# CLOUD_CAPTION_URL=https://limon-arisi-sunum.onrender.com

# İsteğe bağlı: yukarıdaki APP_KEY ile aynı değer olmalı — bulut servisine
# kimlik doğrulaması için gönderilir.
# APP_KEY=degistir-bunu-uzun-rastgele-bir-deger

# İsteğe bağlı: yüklenebilecek TEK bir ham (sıkıştırma öncesi) video dosyası
# için MB cinsinden üst sınır (varsayılan: 2000). Yanlışlıkla devasa bir
# dosya (örn. bir film) seçilip ffmpeg'i uzun süre meşgul etmesini önler.
# MAX_RAW_VIDEO_MB_PER_FILE=2000
