# AI ile açıklama üretimi için Anthropic API anahtarınızı buraya girin.
# Bu dosyayı backend/.env olarak kopyalayıp değeri doldurun.
ANTHROPIC_API_KEY=sk-ant-...

# İsteğe bağlı: caption üretiminde kullanılacak model (varsayılan: claude-opus-5).
# Daha ucuz/hızlı bir model için değiştirebilirsiniz (örn. claude-sonnet-5, claude-haiku-4-5).
# ANTHROPIC_CAPTION_MODEL=claude-sonnet-5

# İsteğe bağlı: ikisi de doluysa siteye girerken ortak kullanıcı adı/şifre
# sorulur (paylaşılan bir sunucuda barındırırken önerilir). Boş bırakılırsa
# (yerel kullanımda olduğu gibi) şifre sorulmaz.
# APP_USERNAME=limonarisi
# APP_PASSWORD=degistir-bunu
