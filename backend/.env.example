# AI ile açıklama üretimi için OpenAI API anahtarınızı buraya girin.
# Bu dosyayı backend/.env olarak kopyalayıp değeri doldurun.
OPENAI_API_KEY=sk-...

# İsteğe bağlı: caption üretiminde kullanılacak model (varsayılan: gpt-4o-mini).
# Farklı bir model için OpenAI dashboard'unda (Models sekmesi) API'de kullanılan
# tam ID'yi kontrol edip buraya yazın (örn. gpt-4o).
# OPENAI_CAPTION_MODEL=gpt-4o

# İsteğe bağlı: ikisi de doluysa siteye girerken ortak kullanıcı adı/şifre
# sorulur (paylaşılan bir sunucuda barındırırken önerilir). Boş bırakılırsa
# (yerel kullanımda olduğu gibi) şifre sorulmaz.
# APP_USERNAME=limonarisi
# APP_PASSWORD=degistir-bunu
